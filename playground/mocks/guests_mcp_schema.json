{
  "table": {
    "name": "GUESTS",
    "columns": [
      { "name": "GUEST_ID",        "type": "string",  "primaryKey": true, "description": "Unique guest identifier (UUID)" },
      { "name": "FIRST_NAME",      "type": "string" },
      { "name": "LAST_NAME",       "type": "string" },
      { "name": "EMAIL",           "type": "string",  "pii": true },
      { "name": "PHONE",           "type": "string",  "pii": true },
      { "name": "LOYALTY_TIER",    "type": "string",  "enum": ["STANDARD", "SILVER", "GOLD", "PLATINUM"] },
      { "name": "CHECK_IN_DATE",   "type": "date" },
      { "name": "CHECK_OUT_DATE",  "type": "date" },
      { "name": "ROOM_NUMBER",     "type": "string" },
      { "name": "NOTES",           "type": "string",  "nullable": true }
    ]
  },
  "tools": [
    {
      "name": "list_guests",
      "description": "List guests, optionally filtered by loyalty tier or check-in date range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loyaltyTier": { "type": "string", "enum": ["STANDARD", "SILVER", "GOLD", "PLATINUM"] },
          "checkInFrom": { "type": "string", "format": "date" },
          "checkInTo":   { "type": "string", "format": "date" },
          "limit":       { "type": "integer", "default": 50, "maximum": 500 }
        }
      }
    },
    {
      "name": "get_guest",
      "description": "Fetch a single guest record by GUEST_ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guestId": { "type": "string" }
        },
        "required": ["guestId"]
      }
    },
    {
      "name": "search_guests",
      "description": "Free-text search across name, email, and room number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "create_guest_reservation",
      "description": "Create a new guest record with a room reservation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstName":     { "type": "string" },
          "lastName":      { "type": "string" },
          "email":         { "type": "string", "format": "email" },
          "phone":         { "type": "string" },
          "checkInDate":   { "type": "string", "format": "date" },
          "checkOutDate":  { "type": "string", "format": "date" },
          "roomNumber":    { "type": "string" }
        },
        "required": ["firstName", "lastName", "email", "checkInDate", "checkOutDate", "roomNumber"]
      }
    },
    {
      "name": "checkout_guest",
      "description": "Mark a guest as checked out.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guestId": { "type": "string" }
        },
        "required": ["guestId"]
      }
    }
  ],
  "sampleData": [
    {
      "GUEST_ID": "g-1001",
      "FIRST_NAME": "Jane",
      "LAST_NAME": "Doe",
      "EMAIL": "jane.doe@example.com",
      "PHONE": "+1-555-0101",
      "LOYALTY_TIER": "GOLD",
      "CHECK_IN_DATE": "2026-09-01",
      "CHECK_OUT_DATE": "2026-09-05",
      "ROOM_NUMBER": "412",
      "NOTES": null
    }
  ]
}
